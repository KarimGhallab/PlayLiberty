{
  "name": "@playliberty/egress-agent",
  "version": "0.1.0",
  "description": "The PlayLiberty egress agent: the pool of Proton configs behind a Unix socket.",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch --noClear -p tsconfig.build.json --onSuccess \"node --env-file=.env dist/main.js\"",
    "watch": "tsc-watch --noClear -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "license": "ISC",
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@playliberty/youtube": "workspace:*",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "pino-pretty": "^13.2.0",
    "tsc-watch": "^7.2.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
