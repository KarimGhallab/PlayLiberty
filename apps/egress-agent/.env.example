# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# The development pool: real Proton configs, never committed.
PROTON_POOL_DIR=./proton
EGRESS_AGENT_SOCKET=/tmp/playliberty-egress.sock
EGRESS_AGENT_PEER_UID=1000
# The active name survives an agent restart. Use a temporary path in dev; the
# unit sets /var/lib/playliberty-egress/active.
EGRESS_STATE_FILE=/tmp/playliberty-egress-active
