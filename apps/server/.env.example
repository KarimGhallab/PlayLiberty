# Runtime

NODE_ENV=development
PORT=8080
# The bind address. Loopback by default, so a development server is not
# reachable from the LAN. A non-loopback bind needs the opt-in below; the
# production pod binds `127.0.0.1` so only the front container that shares its
# network namespace reaches the API.
HOST=127.0.0.1
# Set to `true` only to serve a bind beyond loopback.
ALLOW_NON_LOOPBACK_BIND=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# The media store and the SQLite database. Both are required. The media
# directories are created when missing; the database directory is not.
MEDIA_ROOT=./data/media
DATABASE_PATH=./data/playliberty.db

# Access

# The browser origin the edge serves, checked against Origin and Sec-Fetch-Site
# on mutating requests. Unset disables the check; see docs/ARCHITECTURE.md.
#PUBLIC_ORIGIN=https://playliberty.example.com

# The secret the edge injects under X-PlayLiberty-Edge. Required outside the
# test harness: the origin refuses to start without it, so a direct caller
# cannot forge the forwarded identity. Keep the dev web server's injected
# value in step (it defaults to `dev-edge`).
EDGE_ASSERTION=dev-edge

# Comma-separated Pangolin user ids granted the admin role.
ADMIN_PANGOLIN_USER_IDS=

# Egress

# `local` runs the server's own yt-dlp; `egress-agent` sends listing and
# download calls to the host agent over the Unix socket. Production uses the
# agent so only that traffic leaves through the Proton exit.
YOUTUBE_TRANSPORT=local
EGRESS_AGENT_SOCKET=/run/playliberty/egress-agent.sock
# Five consecutive exit failures rotate; the drain bounds a switch; the
# cooldown keeps a burst of parallel failures from walking the pool.
EGRESS_FAILURE_LIMIT=5
EGRESS_DRAIN_TIMEOUT_MS=60000
EGRESS_SWITCH_COOLDOWN_MS=60000

# Pangolin integration, used by the mobile provisioning flow; see
# docs/ARCHITECTURE.md. Leave unset unless that flow is being exercised. In
# production the four values come from the playliberty_pangolin Podman secret.
#PANGOLIN_API_URL=https://pangolin.example.com/v1
#PANGOLIN_RESOURCE_ID=
#PANGOLIN_INTEGRATION_API_KEY=
# The callbacks the provisioning route may redirect to, comma-separated. The
# HTTPS callback is the app's App Link; the scheme is the fallback.
#MOBILE_REDIRECT_URIS=https://playliberty.example.com/auth/callback,dev.playliberty.app://provision

# Pruning

# Cron for the weekly orphan prune. Default: Sunday at 04:00.
PRUNE_CRON="0 4 * * 0"

# Downloads (yt-dlp)

# Capped at 10 by the schema. The rest are yt-dlp's politeness and retry knobs.
DOWNLOAD_CONCURRENCY=2
DOWNLOAD_SLEEP_REQUESTS=1
DOWNLOAD_SLEEP_INTERVAL_MIN=5
DOWNLOAD_SLEEP_INTERVAL_MAX=15
DOWNLOAD_LIMIT_RATE=5M
DOWNLOAD_RETRIES=10
DOWNLOAD_FRAGMENT_RETRIES=10
DOWNLOAD_FILE_ACCESS_RETRIES=3
DOWNLOAD_SOCKET_TIMEOUT=30
DOWNLOAD_TIMEOUT_MS=900000

# Binaries, resolved from PATH by default.
YTDLP_BINARY=yt-dlp
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
