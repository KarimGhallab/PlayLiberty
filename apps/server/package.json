{
  "name": "@playliberty/server",
  "version": "0.1.0",
  "description": "PlayLiberty server: API, media store, sync, and streaming.",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "build:e2e": "tsc -p tsconfig.e2e.json && node ./scripts/copy-fixtures.mjs dist-e2e",
    "dev": "tsc-watch --noClear -p tsconfig.build.json --onSuccess \"node --env-file=.env dist/main.js\"",
    "watch": "tsc-watch --noClear -p tsconfig.build.json",
    "clean": "rm -rf dist dist-e2e",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "keywords": [],
  "license": "ISC",
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@playliberty/contracts": "workspace:*",
    "@playliberty/youtube": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "26.6.5",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsc-watch": "^7.2.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
