{
  "name": "@playliberty/server",
  "version": "0.1.0",
  "description": "PlayLiberty server: API, media store, sync, and streaming.",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc && node ./scripts/copy-fixtures.mjs",
    "dev": "tsc-watch --noClear --onSuccess \"node --env-file=.env dist/main.js\"",
    "watch": "tsc-watch --noClear",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "keywords": [],
  "license": "ISC",
  "packageManager": "pnpm@12.4.2",
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "@playliberty/contracts": "workspace:*",
    "@playliberty/youtube": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "26.6.2",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tsc-watch": "^7.2.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
