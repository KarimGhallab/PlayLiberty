# syntax=docker/dockerfile:1

# The build context is the repository root, so paths below are
# workspace-relative.

FROM docker.io/library/node:26.12.1-bookworm-slim AS build
ENV CI=true
RUN npm install --global pnpm@12.15.0
WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/api-client/package.json packages/api-client/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/i18n/package.json packages/i18n/package.json
COPY packages/library/package.json packages/library/package.json
COPY packages/player/package.json packages/player/package.json
COPY packages/query/package.json packages/query/package.json
COPY packages/tokens/package.json packages/tokens/package.json
COPY packages/ui-foundation/package.json packages/ui-foundation/package.json
COPY packages/youtube/package.json packages/youtube/package.json
# Only the web client's dependency graph is installed, so the server's native
# modules (and their toolchain) never enter this image.
RUN pnpm install --frozen-lockfile --filter "@playliberty/web..."

COPY . .
RUN pnpm --filter @playliberty/contracts run build \
 && pnpm --filter @playliberty/tokens run build \
 && pnpm --filter @playliberty/i18n run build \
 && pnpm --filter @playliberty/ui-foundation run build \
 && pnpm --filter @playliberty/query run build \
 && pnpm --filter @playliberty/api-client run build \
 && pnpm --filter @playliberty/library run build \
 && pnpm --filter @playliberty/player run build \
 && pnpm --filter @playliberty/web run build

FROM docker.io/nginxinc/nginx-unprivileged:1.31-alpine AS runtime
# The entrypoint substitutes EDGE_ASSERTION into the config template at start.
# Empty so the image runs standalone; a deployment supplies the server's secret.
ENV EDGE_ASSERTION=
# Where nginx proxies the API. The dev stack's separate Compose service by
# default; the production pod overrides it to the pod-local server.
ENV WEB_UPSTREAM=server:8080
COPY apps/web/deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY apps/web/deploy/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html

# The unprivileged image already runs as a non-root user on 8080.
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
