# syntax=docker/dockerfile:1

# The build context is the repository root, so paths below are workspace-relative.

FROM docker.io/library/node:26-bookworm-slim AS build
ENV CI=true
RUN npm install --global pnpm@12.4.2
WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/tokens/package.json packages/tokens/package.json
COPY packages/ui-foundation/package.json packages/ui-foundation/package.json
COPY packages/utils/package.json packages/utils/package.json
COPY packages/youtube/package.json packages/youtube/package.json
# Only the web client's dependency graph is installed, so the server's native
# modules (and their toolchain) never enter this image.
RUN pnpm install --frozen-lockfile --filter "@playliberty/web..."

# The web build needs the token stylesheet, the shared UI decisions and the
# contracts, and each in its dependency order.
COPY . .
RUN pnpm --filter @playliberty/contracts run build \
 && pnpm --filter @playliberty/tokens run build \
 && pnpm --filter @playliberty/ui-foundation run build \
 && pnpm --filter @playliberty/web run build

FROM docker.io/nginxinc/nginx-unprivileged:1.31-alpine AS runtime
COPY apps/web/deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html

# The unprivileged image already runs as a non-root user on 8080.
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
