{
  "name": "PlayLiberté",
  "short_name": "PlayLiberté",
  "description": "Audio player that syncs YouTube playlists and keeps them saved, so a removed video never removes a track.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b0d10",
