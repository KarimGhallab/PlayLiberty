# The single public origin: the SPA and an API proxy to ${WEB_UPSTREAM}, so the
# browser sees one origin and CORS never applies. An envsubst template; the
# production pod publishes no host port and the edge attaches to this container.
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # A cover is capped at 5 MB by the server; the margin lets the server answer
    # an over-size upload instead of nginx replacing it with its own page.
    client_max_body_size 6m;

    # Forwarded unchanged to the server. The Pangolin Remote-* headers and the
    # client's X-PlayLiberty-Client header pass through by default.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # The secret assertion the server requires to tell the edge from a direct
    # caller. Must match the server's EDGE_ASSERTION; locations inherit it.
    proxy_set_header X-PlayLiberty-Edge "${EDGE_ASSERTION}";

    # The security headers every response carries. A location that adds its own
    # header includes this again, because nginx drops the inherited ones there.
    include /etc/nginx/snippets/security-headers.conf;

    location = /healthz {
        proxy_pass http://${WEB_UPSTREAM};
    }

    # The app's provisioning entry: behind SSO, then a redirect back to the app.
    location = /provision {
        proxy_pass http://${WEB_UPSTREAM};
    }

    # The two paths the edge lets through without SSO. They still reach nginx,
    # which adds the assertion; the server refuses them without one.
    location = /auth/exchange {
        proxy_pass http://${WEB_UPSTREAM};
    }

    location = /auth/refresh {
        proxy_pass http://${WEB_UPSTREAM};
    }

    # The live stream never ends: no buffering, a read timeout past the
    # heartbeat. Every other API response keeps nginx's defaults.
    location = /api/v1/events {
        proxy_pass http://${WEB_UPSTREAM};
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_http_version 1.1;
    }

    location /api/ {
        proxy_pass http://${WEB_UPSTREAM};
    }

    # Vite hashes asset filenames, so they are immutable.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # The shell is never cached, so a deploy is picked up on the next load.
    location = /index.html {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Client routes fall back to the shell; /api and /healthz have their own.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
