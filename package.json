{
  "name": "playliberty",
  "version": "0.1.0",
  "description": "Audio player for web and mobile that syncs YouTube playlists and keeps them saved, so you never lose a track to video deletion.",
  "private": true,
  "main": "index.js",
  "type": "module",
  "scripts": {
    "console:start": "pnpm --filter @playliberty/console run start",
    "server:start": "pnpm --filter @playliberty/server run start",
    "server:dev": "pnpm --filter @playliberty/server run dev",
    "web:dev": "pnpm --filter @playliberty/web run dev",
    "web:build": "pnpm --filter @playliberty/web run build",
    "tokens:build": "pnpm --filter @playliberty/tokens run build",
    "tokens:watch": "pnpm --filter @playliberty/tokens run watch",
    "ui-foundation:build": "pnpm --filter @playliberty/ui-foundation run build",
    "ui-foundation:watch": "pnpm --filter @playliberty/ui-foundation run watch",
    "test:unit": "pnpm -r --filter '!@playliberty/e2e' run test",
    "test:e2e": "pnpm --filter @playliberty/e2e run test",
    "test:e2e:typecheck": "pnpm --filter @playliberty/e2e run typecheck",
    "build": "pnpm -r run build",
    "watch": "pnpm -r --parallel run watch",
    "clean": "pnpm -r run clean",
    "lint": "eslint --cache --fix",
    "design:check": "node ./docs/design/scripts/validate-design-tokens.cjs",
    "design:morph": "node ./docs/design/scripts/build-morph-frames.mjs",
    "design:morph:json": "node ./docs/design/scripts/build-morph-frames.mjs --json",
    "design:morph:splice": "node ./docs/design/scripts/splice-morph-block.mjs",
    "format": "npx prettier --list-different --write .",
    "script:unused-code": "npx knip",
    "script:check-updates": "npx ncu --workspaces --interactive",
    "script:code-circular-dependencies": "npx madge --extensions ts --exclude .d.ts --warning --circular apps/ packages/",
    "script:workspace-generate-dependency-graph": "npx depcruise . --output-type archi | dot -T svg > dependency-graph.svg"
  },
  "keywords": [],
  "license": "ISC",
  "packageManager": "pnpm@12.4.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "madge": "^8.0.0",
    "npm-check-updates": "^23.1.0",
    "prettier": "^3.9.8",
    "syncpack": "15.3.3",
    "typescript-eslint": "^8.70.0"
  }
}
