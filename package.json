{
  "name": "playliberty",
  "version": "0.1.0",
  "description": "Audio player for web and mobile that syncs YouTube playlists and keeps them saved, so you never lose a track to video deletion.",
  "private": true,
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:packages && pnpm run dev:apps",
    "dev:apps": "pnpm -r --parallel --filter @playliberty/egress-agent --filter @playliberty/server --filter @playliberty/web run dev",
    "build:packages": "pnpm -r --filter @playliberty/contracts --filter @playliberty/i18n --filter @playliberty/tokens --filter @playliberty/ui-foundation --filter @playliberty/youtube run build",
    "server:start": "pnpm --filter @playliberty/server run start",
    "server:dev": "pnpm --filter @playliberty/server run dev",
    "web:dev": "pnpm --filter @playliberty/web run dev",
    "web:build": "pnpm --filter @playliberty/web run build",
    "mobile:dev": "pnpm --filter @playliberty/mobile run dev",
    "mobile:android": "pnpm --filter @playliberty/mobile run android",
    "mobile:typecheck": "pnpm --filter @playliberty/mobile run typecheck",
    "tokens:build": "pnpm --filter @playliberty/tokens run build",
    "tokens:watch": "pnpm --filter @playliberty/tokens run watch",
    "ui-foundation:build": "pnpm --filter @playliberty/ui-foundation run build",
    "ui-foundation:watch": "pnpm --filter @playliberty/ui-foundation run watch",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:parallel": "pnpm test:unit && pnpm test:e2e:parallel",
    "test:unit": "pnpm -r --filter '!@playliberty/e2e' run test",
    "test:e2e": "pnpm --filter @playliberty/server run build:e2e && pnpm --filter @playliberty/e2e run test",
    "test:e2e:parallel": "pnpm --filter @playliberty/server run build:e2e && pnpm --filter @playliberty/e2e run test:parallel",
    "test:e2e:typecheck": "pnpm --filter @playliberty/e2e run typecheck",
    "build": "pnpm -r run build",
    "deploy:build-for-production": "node deploy/build-production-deployment.mjs",
    "watch": "pnpm -r --parallel run watch",
    "clean": "pnpm -r run clean",
    "lint:fix": "eslint --cache --fix",
    "lint:check": "eslint --cache",
    "format": "npx prettier --list-different --write .",
    "deps-cruise:check": "npx dependency-cruiser .",
    "deps-cruise:graph": "npx dependency-cruiser . --output-type archi | dot -T svg > dependency-graph.svg",
    "script:check-consistent-dependencies": "npx syncpack lint",
    "script:unused-code": "npx knip",
    "script:check-updates": "npx ncu --workspaces --interactive"
  },
  "keywords": [],
  "license": "ISC",
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "knip": "^6.42.1",
    "lint-staged": "^17.6.0",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "syncpack": "15.3.3",
    "typescript-eslint": "^8.72.0"
  }
}
