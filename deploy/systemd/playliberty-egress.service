[Unit]
Description=PlayLiberty egress agent (Proton WireGuard namespace)
Documentation=file:/opt/playliberty/docs/runbooks/egress-agent.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root

WorkingDirectory=/opt/playliberty/apps/egress-agent

StateDirectory=playliberty-egress
StateDirectoryMode=0700

RuntimeDirectory=playliberty
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes

Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/var/lib/playliberty-egress
Environment=XDG_CACHE_HOME=/var/lib/playliberty-egress/cache
Environment=PROTON_POOL_DIR=/etc/playliberty/proton
Environment=EGRESS_AGENT_SOCKET=/run/playliberty/egress-agent.sock
Environment=EGRESS_STATE_FILE=/var/lib/playliberty-egress/active
Environment=WG_INTERFACE=wg0
Environment=EGRESS_VETH_NS=pl-egress1
Environment=EGRESS_VETH_HOST_IP=10.200.0.1
Environment=YTDLP_BINARY=/usr/local/lib/playliberty/yt-dlp
Environment=EGRESS_AGENT_PEER_UID=1000
EnvironmentFile=-/etc/playliberty/egress.env

ExecStart=/usr/local/lib/playliberty/egress-run
ExecStop=/usr/local/lib/playliberty/egress-down

Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s
KillMode=control-group

UMask=0077
NoNewPrivileges=yes

PrivateTmp=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_SETUID CAP_SETGID CAP_KILL

[Install]
WantedBy=multi-user.target
