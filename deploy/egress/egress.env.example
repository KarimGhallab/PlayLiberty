# Installed as /etc/playliberty/egress.env, root-owned 0600.
# The unit sets the pool, socket, state, interface and host yt-dlp paths.
# fatal | error | warn | info | debug | trace | silent
#LOG_LEVEL=info

# The deploying user's uid. The pod connects as this user, and the socket
# directory is owned by it.
EGRESS_AGENT_PEER_UID=1000

# Optional: pin the first boot before /var/lib/playliberty-egress/active exists.
#PROTON_ACTIVE_CONFIG=01-FR-634

# The check's listing URL and the service that answers with the exit address.
#CHECK_URL=https://www.youtube.com/watch?v=jNQXAC9IVRw
#EXIT_IP_URL=https://api.ipify.org
#CHECK_TIMEOUT_MS=60000
#HANDSHAKE_FRESH_MS=180000
