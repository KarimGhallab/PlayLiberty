{
  "name": "@playliberty/ui-foundation",
  "version": "0.1.0",
  "description": "Shared, non-rendering UI decisions for the PlayLiberty clients: track tones, sleeves and easing.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc-watch --noClear -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "keywords": [],
  "license": "ISC",
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@playliberty/contracts": "workspace:*",
    "@playliberty/tokens": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsc-watch": "^7.2.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
