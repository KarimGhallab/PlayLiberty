{
  "name": "@playliberty/api-client",
  "version": "0.1.0",
  "description": "The shared client for the API: one transport, the wire protocol and one hook per endpoint.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc-watch --noClear -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "keywords": [],
  "license": "ISC",
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@playliberty/contracts": "workspace:*",
    "@playliberty/i18n": "workspace:*",
    "@playliberty/library": "workspace:*",
    "@playliberty/query": "workspace:*",
    "@playliberty/ui-foundation": "workspace:*",
    "@tanstack/react-query": "^5.104.5",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "tsc-watch": "^7.2.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
